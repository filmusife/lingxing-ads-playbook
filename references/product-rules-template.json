{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductAdsRulesTemplateV2",
  "description": "通用产品广告诊断规则配置模板（v2，100% 向下兼容旧版 product_rules.json）。放置于 <组合>/work/lx-ads/product_rules.json 或通过 --rules 传入。所有 v2 阈值参数均为可选，未填时自动使用附录 A 默认值。",
  "mode": "AUTO",
  "peak_mode": "AUTO",
  "clearance": false,
  "target_acos": null,
  "launch_acos_multiplier": 1.30,
  "launch_weeks": 6,
  "launch_budget_cap": null,
  "growth_acos_coef": 0.85,
  "profit_acos_coef": 0.68,
  "profit_acos_min": 12.0,
  "profit_acos_max": 35.0,
  "target_net_margin": 10.0,
  "refund_lv1": 12.0,
  "refund_lv2": 15.0,
  "bid_floor_kw": 0.25,
  "bid_floor_kw_fragile": 0.30,
  "bid_floor_asin": 0.36,
  "bid_floor_asin_fragile": 0.42,
  "cvr_prior_k": 20.0,
  "fail_test_clicks_factor": 3.0,
  "fail_test_clicks_min": 15,
  "fail_test_clicks_legacy_floor": 25,
  "change_budget_share": 0.35,
  "change_budget_share_fragile": 0.20,
  "cooldown_days": 7,
  "daypart_min_orders_30d": 60,
  "low_stock_buffer_days": 14,
  "lead_time_days": null,
  "organic_flywheel_cvr": 5.0,
  "organic_flywheel_adv_share": 75.0,
  "organic_flywheel_orders": 45,
  "organic_flywheel_sessions": 1500,
  "organic_fragile_cvr": 1.0,
  "organic_fragile_adv_share": 90.0,
  "organic_fragile_orders": 15,
  "restricted_terms": [],
  "is_patterns": [
    {
      "pattern": "\\b(core_keyword_1|core_keyword_2)\\b",
      "label": "core_feature",
      "note": "本品核心形态与主要卖点词（应该花钱并重点追求 TOS 的搜索词）"
    }
  ],
  "is_not_patterns": [
    {
      "pattern": "\\b(wrong_attribute_1|unsupported_feature|misfit_type)\\b",
      "label": "is_not",
      "note": "本品不具备的功能/不兼容的型号/错品类词根（即使出单也优先否定）"
    }
  ],
  "adjacent_patterns": [
    {
      "pattern": "\\b(compatible_scenario|related_gift_word)\\b",
      "label": "adjacent",
      "note": "相关但非核心主粮词（低预算防守，不盲目冲 TOS）"
    }
  ],
  "competitor_brands": [
    "competitor_brand_a",
    "competitor_brand_b"
  ]
}
